{
  "uid": "fuel-system",
  "title": "System",
  "tags": ["fuel", "system"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend CPU",
      "description": "The backend container's CPU use, in cores.",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"fuel-backend\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cores", "decimals": 3}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Backend memory",
      "description": "The backend container's working set, against its limit.",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{name=\"fuel-backend\"})",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "sum(container_spec_memory_limit_bytes{name=\"fuel-backend\"})",
          "legendFormat": "limit",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Simulator CPU",
      "description": "The simulator container's CPU use, in cores.",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=\"fuel-simulator\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cores", "decimals": 3}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Simulator memory",
      "description": "The simulator container's working set.",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{name=\"fuel-simulator\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU by container",
      "description": "Every container's CPU use. A spike here with the simulator flat usually means the platform is retrying.",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 5},
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cores"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory by container",
      "description": "Working set per container.",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 5},
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory against the limit",
      "description": "How close each container is to being killed for using too much memory.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"}) / sum by (name) (container_spec_memory_limit_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network received",
      "description": "Bytes received per container per second.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Filesystem usage",
      "description": "How much of each container's writable layer is in use.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [
        {
          "expr": "sum by (name) (container_fs_usage_bytes{name!=\"\"})",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container restarts",
      "description": "A rising counter here means the orchestrator is killing a container.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [
        {
          "expr": "sum by (name) (increase(container_restarts_total{name!=\"\"}[15m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
