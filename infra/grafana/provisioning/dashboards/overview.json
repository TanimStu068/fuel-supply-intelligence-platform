{
  "uid": "fuel-platform-overview",
  "title": "Fuel Platform Overview",
  "tags": ["fuel", "hackathon"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend up",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"fuel-backend\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"1": {"text": "UP", "color": "green"}, "0": {"text": "DOWN", "color": "red"}}}]}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate by path",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum by (path) (rate(http_requests_total[1m]))", "legendFormat": "{{path}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error rate (5xx)",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 5},
      "targets": [
        {"expr": "sum by (path) (rate(http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "{{path}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Simulator request latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(simulator_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Simulator retries (fault injection)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [
        {"expr": "sum by (outcome) (rate(simulator_requests_total[1m]))", "legendFormat": "{{outcome}}", "refId": "A"}
      ]
    }
  ]
}
