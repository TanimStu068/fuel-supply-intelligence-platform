# Copy to .env and adjust. Never commit the real .env.
# All values below are the defaults used by docker-compose.yml.

# --- Simulator ---------------------------------------------------------
SIMULATOR_IMAGE=asifmahmoud414/bup-fuel-supply-simulator:1.0.0
SIMULATOR_PORT=8000
# paused | running
SIMULATOR_START_MODE=paused
# Wall-clock ticks per second while running.
SIMULATION_SPEED=8
# Simulated minutes advanced per tick.
TICK_MINUTES=15

# --- Backend -----------------------------------------------------------
BACKEND_PORT=8001
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=fuel
POSTGRES_PORT=5432

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=5173

# --- Observability -----------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-env
