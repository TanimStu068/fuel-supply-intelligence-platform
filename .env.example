# Copy to .env and adjust. Never commit the real .env.
# All values below are the defaults used by docker-compose.yml.

# --- Simulator ---------------------------------------------------------
SIMULATOR_IMAGE=asifmahmoud414/bup-fuel-supply-simulator:1.0.0
SIMULATOR_PORT=8000
# paused | running
SIMULATOR_START_MODE=paused
# Wall-clock ticks per second while running.
SIMULATION_SPEED=8
# Simulated minutes advanced per tick.
TICK_MINUTES=15

# --- Backend -----------------------------------------------------------
BACKEND_PORT=8001
LOG_LEVEL=INFO
METRICS_ENABLED=true

# --- Background sync ---------------------------------------------------
# Poll the simulator over REST on this interval (seconds).
SYNC_POLL_INTERVAL=5
# Base and ceiling for the SSE reconnect backoff (seconds).
SSE_RECONNECT_BASE_DELAY=1
SSE_RECONNECT_MAX_DELAY=30
# How many demand observations to pull per ingest cycle.
DEMAND_HISTORY_LIMIT=500

# --- Database ----------------------------------------------------------
POSTGRES_USER=fuel
POSTGRES_PASSWORD=change-me-in-env
POSTGRES_DB=fuel
POSTGRES_PORT=5432

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=5173
# The origins the backend accepts browser requests from. The dashboard
# is served on FRONTEND_PORT; 4173 is the port the Playwright preview
# server uses for the end-to-end tests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Resilience ----------------------------------------------------------
# How many consecutive simulator failures open the circuit breaker. The
# simulator's own connection pool is small, so without a breaker the
# platform's retries exhaust it.
CIRCUIT_BREAKER_FAILURES=5
# How long the breaker stays open before letting a probe call through.
CIRCUIT_BREAKER_RECOVERY_SECONDS=20
# The health probe's timeout. Short on purpose: it is on the container
# healthcheck's critical path.
SIMULATOR_HEALTH_TIMEOUT=2
# How long the backend may take to drain on SIGTERM before it is killed.
SHUTDOWN_GRACE_SECONDS=15
# How many times a deadlocked transaction is retried. Postgres kills one
# side of a deadlock with SQLSTATE 40001; the standard says to retry it.
DB_DEADLOCK_RETRIES=3
# Compute the prediction-error aggregate in SQL (true) or in Python (false).
# false reproduces the "before" side of the load test's bottleneck
# comparison — see docs/load-test-report.md.
PREDICTION_ERROR_AGGREGATE_IN_DATABASE=true

# --- Resource limits -----------------------------------------------------
# Every service carries a hard ceiling, so a leak is killed at its limit
# instead of taking the host down. See scripts/stack_guard.sh.
SIMULATOR_MEM_LIMIT=768m
SIMULATOR_CPUS=1.0
BACKEND_MEM_LIMIT=640m
BACKEND_CPUS=1.5
POSTGRES_MEM_LIMIT=640m
POSTGRES_CPUS=1.0
FRONTEND_MEM_LIMIT=192m
FRONTEND_CPUS=0.5
PROMETHEUS_MEM_LIMIT=512m
PROMETHEUS_CPUS=0.75
GRAFANA_MEM_LIMIT=512m
GRAFANA_CPUS=0.75
CADVISOR_MEM_LIMIT=384m
CADVISOR_CPUS=0.5

# --- Observability -----------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8080
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-env
